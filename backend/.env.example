# CIDAN (Compliance Intelligence & Dynamic Adaptation Network)
# Backend Environment Configuration

# OpenAI API Configuration (Official Python SDK)
# Provide your OpenAI API key below to enable natural language synthesis and conversational memory.
# If left empty, CIDAN operates in local extractive synthesis mode without calling external APIs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding Model (SentenceTransformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage paths (relative to backend directory)
# CHROMA_PERSIST_DIR=data/chromadb
# UPLOADS_DIR=data/uploads
